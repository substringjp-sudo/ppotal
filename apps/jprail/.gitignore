# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase
firebase-debug.log*
.runtimeconfig.json

# ide
.idx
.vscode
.idea


# OSM 운행계통 내보내기 — 전국 내보내기는 수십 MB 라 커밋하지 않는다.
# 파이프라인 표본인 야마노테선 것만 남긴다. data/osm/README.md 참고.
data/osm/*
!data/osm/README.md
!data/osm/yamanote.geojson

# 되짚기 타임라인 검증용 임시 산출물
/.verify/
.station-codes-cache/
